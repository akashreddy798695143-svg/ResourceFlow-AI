generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  phone              String?
  name               String
  emailVerified      Boolean              @default(false)
  phoneVerified      Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  active             Boolean              @default(true)
  emailNotifications Boolean              @default(true)
  inAppNotifications Boolean              @default(true)
  passwordHash       String?
  smsNotifications   Boolean              @default(true)
  role               Role                 @default(CITIZEN)
  approvals          Approval[]
  auditLogs          AuditLog[]
  incidents          Incident[]
  notifications      Notification[]
  notificationLogs   NotificationLog[]
  otpVerifications   OtpVerification[]
  resourceOps        ResourceAssignment[]

  @@index([phone])
}

model Incident {
  id                     String               @id @default(cuid())
  incidentCode           String               @unique
  type                   IncidentType
  description            String
  location               String
  latitude               Float
  longitude              Float
  imageMeta              String?
  status                 IncidentStatus       @default(NEW)
  duplicateFlag          Boolean              @default(false)
  citizenName            String?
  citizenPhone           String?
  citizenEmail           String?
  originalDescription    String?
  transcription          String?
  language               String?
  inputMethod            String?
  locationAccuracy       Float?
  locationTimestamp      DateTime?
  aiSeverity             String?
  aiPeopleAffected       Int?
  aiUrgentNeeds          String?
  aiRoadBlocked          Boolean?
  aiInfrastructureDamage String?
  aiRiskFactors          String?
  aiConfidence           Float?
  aiMissingInfo          String?
  aiAvailable            Boolean              @default(true)
  riskScore              Float?
  riskLevel              RiskLevel?
  riskReasons            String?
  weather                String?
  clusterId              String?
  assignedResourceId     String?
  assignedAt             DateTime?
  acknowledgedAt         DateTime?
  startedAt              DateTime?
  arrivedAt              DateTime?
  resolvedAt             DateTime?
  escalationLevel        Int                  @default(0)
  resolutionEmailSent    Boolean              @default(false)
  resolutionEmailSentAt  DateTime?
  reportedById           String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  recommendations        AIRecommendation[]
  approvals              Approval[]
  emailNotifications     EmailNotification[]
  report                 GeneratedReport?
  reportedBy             User                 @relation(fields: [reportedById], references: [id])
  events                 IncidentEvent[]
  assignments            ResourceAssignment[]

  @@index([status])
  @@index([type])
  @@index([clusterId])
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  eventType  String
  data       String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentCluster {
  id             String       @id @default(cuid())
  clusterCode    String       @unique
  type           IncidentType
  confidence     Float
  incidentIds    String
  geoSpreadKm    Float
  latestReportAt DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Resource {
  id           String               @id @default(cuid())
  resourceCode String               @unique
  name         String
  type         ResourceType
  latitude     Float
  longitude    Float
  capacity     Int
  status       ResourceStatus       @default(AVAILABLE)
  eta          Int?
  lastUpdated  DateTime             @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  assignments  ResourceAssignment[]

  @@index([status])
  @@index([type])
}

model ResourceAssignment {
  id           String    @id @default(cuid())
  resourceId   String
  incidentId   String
  status       String    @default("ASSIGNED")
  isPrimary    Boolean   @default(true)
  reason       String?
  assignedById String?
  assignedAt   DateTime  @default(now())
  replacedAt   DateTime?
  responder    User?     @relation(fields: [assignedById], references: [id])
  incident     Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  resource     Resource  @relation(fields: [resourceId], references: [id])

  @@index([resourceId])
  @@index([incidentId])
}

model Approval {
  id             String           @id @default(cuid())
  incidentId     String
  resourceId     String?
  recommendation String
  decision       ApprovalDecision @default(PENDING)
  reviewerId     String?
  reason         String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  incident       Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  reviewer       User?            @relation(fields: [reviewerId], references: [id])

  @@index([decision])
}

model AIRecommendation {
  id         String   @id @default(cuid())
  incidentId String
  recType    String
  payload    String
  source     String   @default("ai")
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  message   String
  createdAt DateTime         @default(now())
  entityId  String?
  read      Boolean          @default(false)
  type      NotificationType
  user      User?            @relation(fields: [userId], references: [id])

  @@index([read])
  @@index([userId])
}

model AuditLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  userId        String?
  role          String?
  action        String
  entityId      String?
  previousState String?
  newState      String?
  reason        String?
  user          User?    @relation(fields: [userId], references: [id])

  @@index([action])
}

model GeneratedReport {
  id         String   @id @default(cuid())
  incidentId String   @unique
  content    String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model EmailNotification {
  id              String      @id @default(cuid())
  incidentId      String
  recipientEmail  String
  recipientUserId String?
  emailType       EmailType
  subject         String
  status          EmailStatus @default(PENDING)
  sentAt          DateTime?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  incident        Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([recipientUserId])
  @@index([status])
}

model OtpVerification {
  id          String    @id @default(cuid())
  identifier  String
  channel     String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumed    Boolean   @default(false)
  consumedAt  DateTime?
  userId      String?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id])

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model NotificationLog {
  id               String    @id @default(cuid())
  userId           String?
  incidentId       String?
  notificationType String
  channel          String
  recipient        String
  title            String
  message          String
  status           String    @default("PENDING")
  sentAt           DateTime?
  readAt           DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  user             User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([incidentId])
  @@index([notificationType])
  @@index([status])
}

model SimulationRun {
  id        String            @id @default(cuid())
  scenario  String
  status    SimulationStatus  @default(RUNNING)
  config    String
  metrics   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  events    SimulationEvent[]

  @@index([scenario])
}

model SimulationEvent {
  id         String        @id @default(cuid())
  runId      String
  simTimeMin Int
  eventType  String
  label      String
  data       String
  createdAt  DateTime      @default(now())
  run        SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

enum Role {
  CITIZEN
  RESPONDER
  DISASTER_OFFICER
  ADMIN
}

enum IncidentType {
  FLOOD
  CYCLONE
  EARTHQUAKE
  LANDSLIDE
  ROAD_BLOCKAGE
  FIRE
  MEDICAL
  INFRASTRUCTURE
  OTHER
}

enum IncidentStatus {
  NEW
  ANALYZING
  VERIFICATION
  PRIORITIZED
  AWAITING_APPROVAL
  ASSIGNED
  IN_PROGRESS
  DELAYED
  ESCALATED
  RESOLVED
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResourceType {
  AMBULANCE
  RESCUE_TEAM
  FIRE_TEAM
  EMERGENCY_VEHICLE
  MEDICAL_SUPPLY
  FOOD_SUPPLY
  WATER_SUPPLY
}

enum ResourceStatus {
  AVAILABLE
  ASSIGNED
  EN_ROUTE
  ON_SCENE
  UNAVAILABLE
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  INFO
  WARNING
  CRITICAL
  APPROVAL_REQUIRED
  ESCALATION
  RESOLUTION
}

enum EmailType {
  CITIZEN_RESOLUTION_REPORT
  OFFICER_RESOLUTION_REPORT
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum SimulationStatus {
  RUNNING
  COMPLETED
  FAILED
}
