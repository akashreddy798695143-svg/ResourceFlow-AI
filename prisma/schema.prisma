generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIRecommendation {
  id         String   @id
  incidentId String
  recType    String
  payload    String
  source     String   @default("ai")
  createdAt  DateTime @default(now())
  Incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model AiInsight {
  id          String    @id
  incidentId  String?
  feature     String
  severity    RiskLevel @default(LOW)
  confidence  Float?
  payload     Json
  source      String    @default("deterministic")
  demo        Boolean   @default(false)
  status      String    @default("ACTIVE")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User?     @relation(fields: [createdById], references: [id])
  Incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([feature, status])
  @@index([incidentId])
}

model Approval {
  id             String           @id
  incidentId     String
  resourceId     String?
  recommendation String
  decision       ApprovalDecision @default(PENDING)
  reviewerId     String?
  reason         String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  Incident       Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  User           User?            @relation(fields: [reviewerId], references: [id])

  @@index([decision])
}

model AuditLog {
  id            String   @id
  timestamp     DateTime @default(now())
  userId        String?
  role          String?
  action        String
  entityId      String?
  previousState String?
  newState      String?
  reason        String?
  User          User?    @relation(fields: [userId], references: [id])

  @@index([action])
}

model CommsBlackout {
  id              String    @id
  mode            String    @default("PARTIAL")
  reason          String
  affectedRegions Json?
  active          Boolean   @default(true)
  startedById     String?
  startedAt       DateTime  @default(now())
  endsAt          DateTime?
  demo            Boolean   @default(false)
  User            User?     @relation(fields: [startedById], references: [id])

  @@index([active])
}

model DemandForecast {
  id              String       @id
  region          String
  resourceType    ResourceType
  horizonHours    Int          @default(24)
  predictedDemand Int
  currentSupply   Int
  gap             Int
  confidence      Float
  source          String       @default("deterministic")
  demo            Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@index([region, resourceType])
}

model EmailNotification {
  id              String      @id
  incidentId      String
  recipientEmail  String
  recipientUserId String?
  emailType       EmailType
  subject         String
  status          EmailStatus @default(PENDING)
  sentAt          DateTime?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  Incident        Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([recipientUserId])
  @@index([status])
}

model EvacuationCorridor {
  id              String    @id
  corridorCode    String    @unique
  name            String
  fromLabel       String
  toSafeZoneId    String?
  path            Json
  distanceKm      Float
  etaMinutes      Int
  capacityPerHour Int
  riskScore       Float
  status          String    @default("PROPOSED")
  incidentId      String?
  source          String    @default("deterministic")
  demo            Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Incident        Incident? @relation(fields: [incidentId], references: [id])
  SafeZone        SafeZone? @relation(fields: [toSafeZoneId], references: [id])

  @@index([status])
}

model GeneratedReport {
  id         String   @id
  incidentId String   @unique
  content    String
  createdAt  DateTime @default(now())
  Incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model HazardReport {
  id            String       @id
  reportedById  String
  hazardType    HazardType
  description   String
  location      String
  latitude      Float
  longitude     Float
  severity      Severity     @default(MEDIUM)
  status        HazardStatus @default(REPORTED)
  aiCategory    String?
  aiConfidence  Float?
  aiSummary     String?
  duplicateOfId String?
  clusterKey    String?
  confirmCount  Int          @default(1)
  verified      Boolean      @default(false)
  verifiedById  String?
  verifiedAt    DateTime?
  language      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  User          User         @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([clusterKey])
  @@index([hazardType])
  @@index([status])
}

model Hospital {
  id            String    @id
  name          String
  latitude      Float
  longitude     Float
  totalBeds     Int
  availableBeds Int
  icuAvailable  Int       @default(0)
  erLoadPct     Int       @default(0)
  status        String    @default("ACCEPTING")
  incidentId    String?
  source        String    @default("demo")
  demo          Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Incident      Incident? @relation(fields: [incidentId], references: [id])

  @@index([status])
}

model Incident {
  id                                                 String                   @id
  incidentCode                                       String                   @unique
  type                                               IncidentType
  description                                        String
  location                                           String
  latitude                                           Float
  longitude                                          Float
  imageMeta                                          String?
  status                                             IncidentStatus           @default(NEW)
  duplicateFlag                                      Boolean                  @default(false)
  citizenName                                        String?
  citizenPhone                                       String?
  citizenEmail                                       String?
  originalDescription                                String?
  transcription                                      String?
  language                                           String?
  inputMethod                                        String?
  locationAccuracy                                   Float?
  locationTimestamp                                  DateTime?
  aiSeverity                                         String?
  aiPeopleAffected                                   Int?
  aiUrgentNeeds                                      String?
  aiRoadBlocked                                      Boolean?
  aiInfrastructureDamage                             String?
  aiRiskFactors                                      String?
  aiConfidence                                       Float?
  aiMissingInfo                                      String?
  aiAvailable                                        Boolean                  @default(true)
  riskScore                                          Float?
  riskLevel                                          RiskLevel?
  riskReasons                                        String?
  weather                                            String?
  clusterId                                          String?
  assignedResourceId                                 String?
  assignedAt                                         DateTime?
  acknowledgedAt                                     DateTime?
  startedAt                                          DateTime?
  arrivedAt                                          DateTime?
  resolvedAt                                         DateTime?
  escalationLevel                                    Int                      @default(0)
  resolutionEmailSent                                Boolean                  @default(false)
  resolutionEmailSentAt                              DateTime?
  reportedById                                       String
  createdAt                                          DateTime                 @default(now())
  updatedAt                                          DateTime
  AIRecommendation                                   AIRecommendation[]
  AiInsight                                          AiInsight[]
  Approval                                           Approval[]
  EmailNotification                                  EmailNotification[]
  EvacuationCorridor                                 EvacuationCorridor[]
  GeneratedReport                                    GeneratedReport?
  Hospital                                           Hospital[]
  User                                               User                     @relation(fields: [reportedById], references: [id])
  IncidentEvent                                      IncidentEvent[]
  IncidentLink_IncidentLink_fromIncidentIdToIncident IncidentLink[]           @relation("IncidentLink_fromIncidentIdToIncident")
  IncidentLink_IncidentLink_toIncidentIdToIncident   IncidentLink[]           @relation("IncidentLink_toIncidentIdToIncident")
  LearningEntry                                      LearningEntry[]
  MarketplaceListing                                 MarketplaceListing[]
  MissingPerson                                      MissingPerson[]
  OperationalObservation                             OperationalObservation[]
  ResourceAssignment                                 ResourceAssignment[]
  SafeZone                                           SafeZone[]
  Shipment                                           Shipment[]

  @@index([clusterId])
  @@index([status])
  @@index([type])
}

model IncidentCluster {
  id             String       @id
  clusterCode    String       @unique
  type           IncidentType
  confidence     Float
  incidentIds    String
  geoSpreadKm    Float
  latestReportAt DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
}

model IncidentEvent {
  id         String   @id
  incidentId String
  eventType  String
  data       String
  createdAt  DateTime @default(now())
  Incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentLink {
  id                                             String   @id
  fromIncidentId                                 String
  toIncidentId                                   String
  relation                                       String
  strength                                       Float    @default(0.5)
  explanation                                    String?
  source                                         String   @default("deterministic")
  createdAt                                      DateTime @default(now())
  Incident_IncidentLink_fromIncidentIdToIncident Incident @relation("IncidentLink_fromIncidentIdToIncident", fields: [fromIncidentId], references: [id], onDelete: Cascade)
  Incident_IncidentLink_toIncidentIdToIncident   Incident @relation("IncidentLink_toIncidentIdToIncident", fields: [toIncidentId], references: [id], onDelete: Cascade)

  @@unique([fromIncidentId, toIncidentId, relation])
  @@index([fromIncidentId])
  @@index([toIncidentId])
}

model LearningEntry {
  id             String    @id
  incidentId     String?
  category       String
  lesson         String
  recommendation String?
  confidence     Float?
  source         String    @default("deterministic")
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  Incident       Incident? @relation(fields: [incidentId], references: [id])

  @@index([status])
}

model MarketplaceListing {
  id            String       @id
  listingCode   String       @unique
  kind          String       @default("OFFER")
  agencyName    String
  resourceType  ResourceType
  quantity      Int
  unit          String       @default("units")
  pricePerUnit  Float?
  notes         String?
  status        String       @default("OPEN")
  matchedWithId String?
  incidentId    String?
  listedById    String?
  demo          Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  Incident      Incident?    @relation(fields: [incidentId], references: [id])
  User          User?        @relation(fields: [listedById], references: [id])

  @@index([status])
}

model MissingPerson {
  id               String    @id
  fullName         String
  age              Int?
  gender           String?
  description      String?
  lastSeenAt       DateTime?
  lastSeenLocation String
  latitude         Float?
  longitude        Float?
  contactName      String?
  contactPhone     String?
  medicalNeeds     Boolean   @default(false)
  childOrElder     Boolean   @default(false)
  priorityScore    Float?
  status           String    @default("OPEN")
  foundAt          DateTime?
  incidentId       String?
  reportedById     String
  source           String    @default("deterministic")
  demo             Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  Incident         Incident? @relation(fields: [incidentId], references: [id])
  User             User      @relation(fields: [reportedById], references: [id])

  @@index([status])
}

model Notification {
  id        String           @id
  userId    String?
  message   String
  createdAt DateTime         @default(now())
  entityId  String?
  read      Boolean          @default(false)
  type      NotificationType
  User      User?            @relation(fields: [userId], references: [id])

  @@index([read])
  @@index([userId])
}

model NotificationLog {
  id               String    @id
  userId           String?
  incidentId       String?
  notificationType String
  channel          String
  recipient        String
  title            String
  message          String
  status           String    @default("PENDING")
  sentAt           DateTime?
  readAt           DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  User             User?     @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([notificationType])
  @@index([status])
  @@index([userId])
}

model OperationalObservation {
  id          String   @id
  incidentId  String
  createdById String
  kind        String
  recordCode  String
  payload     Json
  simulated   Boolean  @default(false)
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [createdById], references: [id])
  Incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, kind, recordCode, createdAt])
}

model OtpVerification {
  id          String    @id
  identifier  String
  channel     String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumed    Boolean   @default(false)
  consumedAt  DateTime?
  userId      String?
  createdAt   DateTime  @default(now())
  User        User?     @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@index([identifier, purpose])
}

model ReliefRequest {
  id            String              @id
  requestedById String
  needType      ReliefNeedType
  quantity      String?
  urgency       Severity            @default(MEDIUM)
  notes         String?
  location      String
  latitude      Float?
  longitude     Float?
  status        ReliefRequestStatus @default(OPEN)
  incidentId    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime
  User          User                @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([needType])
  @@index([status])
}

model Resource {
  id                 String               @id
  resourceCode       String               @unique
  name               String
  type               ResourceType
  latitude           Float
  longitude          Float
  capacity           Int
  status             ResourceStatus       @default(AVAILABLE)
  eta                Int?
  lastUpdated        DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  ResourceAssignment ResourceAssignment[]

  @@index([status])
  @@index([type])
}

model ResourceAssignment {
  id           String    @id
  resourceId   String
  incidentId   String
  status       String    @default("ASSIGNED")
  isPrimary    Boolean   @default(true)
  reason       String?
  assignedById String?
  assignedAt   DateTime  @default(now())
  replacedAt   DateTime?
  User         User?     @relation(fields: [assignedById], references: [id])
  Incident     Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  Resource     Resource  @relation(fields: [resourceId], references: [id])

  @@index([incidentId])
  @@index([resourceId])
}

model ResourceExpiry {
  id             String       @id
  batchCode      String       @unique
  name           String
  type           ResourceType
  quantity       Int
  unit           String       @default("units")
  storageSite    String
  expiresAt      DateTime
  spoilageRisk   Float?
  recommendation String?
  resourceId     String?
  source         String       @default("deterministic")
  demo           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime

  @@index([expiresAt])
}

model SafeCheckIn {
  id           String   @id
  userId       String
  isSafe       Boolean  @default(true)
  message      String?
  latitude     Float?
  longitude    Float?
  locationName String?
  sharedWith   Json?
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SafeZone {
  id                 String               @id
  name               String
  zoneCode           String               @unique
  type               String
  latitude           Float
  longitude          Float
  capacity           Int
  occupancy          Int                  @default(0)
  riskLevel          RiskLevel            @default(LOW)
  status             String               @default("OPEN")
  amenities          String?
  incidentId         String?
  source             String               @default("deterministic")
  demo               Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  EvacuationCorridor EvacuationCorridor[]
  Incident           Incident?            @relation(fields: [incidentId], references: [id])

  @@index([status])
}

model SafetyContact {
  id                 String    @id
  ownerId            String
  name               String
  phone              String
  relation           String    @default("FAMILY")
  isPrimary          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  email              String?
  emailVerified      Boolean   @default(false)
  lastNotificationAt DateTime?
  notificationStatus String?
  User               User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model ShelterFeedback {
  id           String        @id
  incidentId   String?
  shelterName  String
  status       ShelterStatus
  occupancyPct Int?
  waitMinutes  Int?
  suppliesNote String?
  reportedById String
  createdAt    DateTime      @default(now())
  User         User          @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([shelterName])
}

model Shipment {
  id           String    @id
  shipmentCode String    @unique
  description  String
  origin       String
  destination  String
  incidentId   String?
  status       String    @default("PREPARING")
  currentStep  Int       @default(0)
  eta          DateTime?
  steps        Json
  source       String    @default("deterministic")
  demo         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Incident     Incident? @relation(fields: [incidentId], references: [id])

  @@index([status])
}

model SimulationEvent {
  id            String        @id
  runId         String
  simTimeMin    Int
  eventType     String
  label         String
  data          String
  createdAt     DateTime      @default(now())
  SimulationRun SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model SimulationRun {
  id              String            @id
  scenario        String
  status          SimulationStatus  @default(RUNNING)
  config          String
  metrics         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  SimulationEvent SimulationEvent[]

  @@index([scenario])
}

model User {
  id                     String                   @id
  email                  String                   @unique
  phone                  String?
  name                   String
  emailVerified          Boolean                  @default(false)
  phoneVerified          Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  active                 Boolean                  @default(true)
  emailNotifications     Boolean                  @default(true)
  inAppNotifications     Boolean                  @default(true)
  passwordHash           String?
  smsNotifications       Boolean                  @default(true)
  role                   Role                     @default(CITIZEN)
  AiInsight              AiInsight[]
  Approval               Approval[]
  AuditLog               AuditLog[]
  CommsBlackout          CommsBlackout[]
  HazardReport           HazardReport[]
  Incident               Incident[]
  MarketplaceListing     MarketplaceListing[]
  MissingPerson          MissingPerson[]
  Notification           Notification[]
  NotificationLog        NotificationLog[]
  OperationalObservation OperationalObservation[]
  OtpVerification        OtpVerification[]
  ReliefRequest          ReliefRequest[]
  ResourceAssignment     ResourceAssignment[]
  SafeCheckIn            SafeCheckIn[]
  SafetyContact          SafetyContact[]
  ShelterFeedback        ShelterFeedback[]
  VerifiedAlert          VerifiedAlert[]
  VolunteerRegistration  VolunteerRegistration?
  WhatIfRun              WhatIfRun[]

  @@index([phone])
}

model VerifiedAlert {
  id            String    @id
  title         String
  body          String
  severity      Severity  @default(MEDIUM)
  area          String?
  incidentId    String?
  active        Boolean   @default(true)
  language      String?
  publishedById String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  User          User      @relation(fields: [publishedById], references: [id])

  @@index([active, createdAt])
}

model VolunteerRegistration {
  id           String          @id
  userId       String          @unique
  skills       String
  availability String
  areas        String?
  hasTransport Boolean         @default(false)
  status       VolunteerStatus @default(PENDING)
  verifiedSafe Boolean         @default(false)
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime
  User         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatIfRun {
  id          String   @id
  name        String
  params      Json
  results     Json?
  narrative   String?
  source      String   @default("deterministic")
  demo        Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [createdById], references: [id])

  @@index([createdAt])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum EmailType {
  CITIZEN_RESOLUTION_REPORT
  OFFICER_RESOLUTION_REPORT
}

enum HazardStatus {
  REPORTED
  CONFIRMED
  RESOLVED
  DISMISSED
}

enum HazardType {
  FLOODING
  BLOCKED_ROAD
  DEBRIS
  DOWNED_POWER_LINE
  FIRE
  STRUCTURAL_DAMAGE
  LANDSLIDE
  OTHER
}

enum IncidentStatus {
  NEW
  ANALYZING
  VERIFICATION
  PRIORITIZED
  AWAITING_APPROVAL
  ASSIGNED
  IN_PROGRESS
  DELAYED
  ESCALATED
  RESOLVED
  CLOSED
}

enum IncidentType {
  FLOOD
  CYCLONE
  EARTHQUAKE
  LANDSLIDE
  ROAD_BLOCKAGE
  FIRE
  MEDICAL
  INFRASTRUCTURE
  OTHER
  BUILDING_COLLAPSE
  FOREST_FIRE
  HEAVY_RAINFALL
  INDUSTRIAL_ACCIDENT
}

enum NotificationType {
  INFO
  WARNING
  CRITICAL
  APPROVAL_REQUIRED
  ESCALATION
  RESOLUTION
}

enum ReliefNeedType {
  FOOD
  WATER
  MEDICAL
  SHELTER
  CLOTHING
  RESCUE
  POWER
  OTHER
}

enum ReliefRequestStatus {
  OPEN
  ACKNOWLEDGED
  FULFILLED
  CANCELLED
}

enum ResourceStatus {
  AVAILABLE
  ASSIGNED
  EN_ROUTE
  ON_SCENE
  UNAVAILABLE
}

enum ResourceType {
  AMBULANCE
  RESCUE_TEAM
  FIRE_TEAM
  EMERGENCY_VEHICLE
  MEDICAL_SUPPLY
  FOOD_SUPPLY
  WATER_SUPPLY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  CITIZEN
  RESPONDER
  DISASTER_OFFICER
  ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ShelterStatus {
  OPEN
  CROWDED
  FULL
  CLOSED
}

enum SimulationStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum VolunteerStatus {
  PENDING
  APPROVED
  ACTIVE
  INACTIVE
  REJECTED
}
