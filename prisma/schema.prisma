generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIRecommendation {
  id         String   @id @default(cuid())
  incidentId String
  recType    String
  payload    String
  source     String   @default("ai")
  createdAt  DateTime @default(now())
  Incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model AiInsight {
  id          String    @id @default(cuid())
  incidentId  String?
  feature     String
  severity    RiskLevel @default(LOW)
  confidence  Float?
  payload     Json
  source      String    @default("deterministic")
  demo        Boolean   @default(false)
  status      String    @default("ACTIVE")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  User        User?     @relation(fields: [createdById], references: [id])
  Incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([feature, status])
  @@index([incidentId])
}

model Approval {
  id             String           @id @default(cuid())
  incidentId     String
  resourceId     String?
  recommendation String
  decision       ApprovalDecision @default(PENDING)
  reviewerId     String?
  reason         String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  Incident       Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  User           User?            @relation(fields: [reviewerId], references: [id])

  @@index([decision])
}

model AuditLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  userId        String?
  role          String?
  action        String
  entityId      String?
  previousState String?
  newState      String?
  reason        String?
  User          User?    @relation(fields: [userId], references: [id])

  @@index([action])
}

model CommsBlackout {
  id              String    @id @default(cuid())
  mode            String    @default("PARTIAL")
  reason          String
  affectedRegions Json?
  active          Boolean   @default(true)
  startedById     String?
  startedAt       DateTime  @default(now())
  endsAt          DateTime?
  demo            Boolean   @default(false)
  User            User?     @relation(fields: [startedById], references: [id])

  @@index([active])
}

model DemandForecast {
  id              String       @id @default(cuid())
  region          String
  resourceType    ResourceType
  horizonHours    Int          @default(24)
  predictedDemand Int
  currentSupply   Int
  gap             Int
  confidence      Float
  source          String       @default("deterministic")
  demo            Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@index([region, resourceType])
}

model EmailNotification {
  id              String      @id @default(cuid())
  incidentId      String
  recipientEmail  String
  recipientUserId String?
  emailType       EmailType
  subject         String
  status          EmailStatus @default(PENDING)
  sentAt          DateTime?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now())
  Incident        Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([recipientUserId])
  @@index([status])
}

model EvacuationCorridor {
  id              String    @id @default(cuid())
  corridorCode    String    @unique
  name            String
  fromLabel       String
  toSafeZoneId    String?
  path            Json
  distanceKm      Float
  etaMinutes      Int
  capacityPerHour Int
  riskScore       Float
  status          String    @default("PROPOSED")
  incidentId      String?
  source          String    @default("deterministic")
  demo            Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())
  Incident        Incident? @relation(fields: [incidentId], references: [id])
  SafeZone        SafeZone? @relation(fields: [toSafeZoneId], references: [id])

  @@index([status])
}

model GeneratedReport {
  id         String   @id @default(cuid())
  incidentId String   @unique
  content    String
  createdAt  DateTime @default(now())
  Incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model HazardReport {
  id            String       @id @default(cuid())
  reportedById  String
  hazardType    HazardType
  description   String
  location      String
  latitude      Float
  longitude     Float
  severity      Severity     @default(MEDIUM)
  status        HazardStatus @default(REPORTED)
  aiCategory    String?
  aiConfidence  Float?
  aiSummary     String?
  duplicateOfId String?
  clusterKey    String?
  confirmCount  Int          @default(1)
  verified      Boolean      @default(false)
  verifiedById  String?
  verifiedAt    DateTime?
  language      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now())
  User          User         @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([clusterKey])
  @@index([hazardType])
  @@index([status])
}

model Hospital {
  id            String    @id @default(cuid())
  name          String
  latitude      Float
  longitude     Float
  totalBeds     Int
  availableBeds Int
  icuAvailable  Int       @default(0)
  erLoadPct     Int       @default(0)
  status        String    @default("ACCEPTING")
  incidentId    String?
  source        String    @default("demo")
  demo          Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
  Incident      Incident? @relation(fields: [incidentId], references: [id])

  @@index([status])
}

model Incident {
  id                                                 String                   @id @default(cuid())
  incidentCode                                       String                   @unique
  type                                               IncidentType
  description                                        String
  location                                           String
  latitude                                           Float
  longitude                                          Float
  imageMeta                                          String?
  status                                             IncidentStatus           @default(NEW)
  duplicateFlag                                      Boolean                  @default(false)
  citizenName                                        String?
  citizenPhone                                       String?
  citizenEmail                                       String?
  originalDescription                                String?
  transcription                                      String?
  language                                           String?
  inputMethod                                        String?
  locationAccuracy                                   Float?
  locationTimestamp                                  DateTime?
  aiSeverity                                         String?
  aiPeopleAffected                                   Int?
  aiUrgentNeeds                                      String?
  aiRoadBlocked                                      Boolean?
  aiInfrastructureDamage                             String?
  aiRiskFactors                                      String?
  aiConfidence                                       Float?
  aiMissingInfo                                      String?
  aiAvailable                                        Boolean                  @default(true)
  riskScore                                          Float?
  riskLevel                                          RiskLevel?
  riskReasons                                        String?
  weather                                            String?
  clusterId                                          String?
  assignedResourceId                                 String?
  assignedAt                                         DateTime?
  acknowledgedAt                                     DateTime?
  startedAt                                          DateTime?
  arrivedAt                                          DateTime?
  resolvedAt                                         DateTime?
  escalationLevel                                    Int                      @default(0)
  resolutionEmailSent                                Boolean                  @default(false)
  resolutionEmailSentAt                              DateTime?
  // NEW: Citizen emergency location tracking (Feature 1)
  citizenLatitude                                    Float?
  citizenLongitude                                   Float?
  citizenLocationTimestamp                           DateTime?
  citizenDestinationLatitude                         Float?
  citizenDestinationLongitude                        Float?
  citizenDestinationName                             String?
  citizenMovementStatus                              String?                  @default("STATIC")
  // NEW: Resource destination (Feature 2-5)
  resourceDestinationLatitude                        Float?
  resourceDestinationLongitude                       Float?
  resourceDestinationName                            String?
  resourceDestinationType                            String?
  // NEW: Impact zones (Feature 16)
  impactZone1Km                                      String?
  impactZone5Km                                      String?
  impactZone10Km                                     String?
  // NEW: Cascade risk (Feature 17)
  cascadeRisk                                        String?
  // NEW: Smart resource matching (Feature 14)
  aiRecommendedResources                             String?
  resourceRequirementEstimate                        String?
  // NEW: Automatic arrival tracking (Feature 5)
  autoArrivalVerified                                Boolean                  @default(false)
  manualArrivalConfirmed                             Boolean                  @default(false)
  arrivalVerifiedById                                String?
  arrivalVerifiedAt                                  DateTime?
  // NEW Relations for new models
  EmergencyServices                                  EmergencyService[]
  SafePlaces                                         SafePlace[]
  // Existing relations
  ResourceAssignment                                 ResourceAssignment[]
  // New relations for resource tracking
  Events                                             ResourceTrackingEvent[]
  Destinations                                       ResourceDestination[]
  // The reporter (FK) — always from session, never from frontend
  reportedById                                       String
  createdAt                                          DateTime                 @default(now())
  updatedAt                                          DateTime                 @default(now())
  AIRecommendation                                   AIRecommendation[]
  AiInsight                                          AiInsight[]
  Approval                                           Approval[]
  EmailNotification                                  EmailNotification[]
  EvacuationCorridor                                 EvacuationCorridor[]
  GeneratedReport                                    GeneratedReport?
  Hospital                                           Hospital[]
  User                                               User                     @relation(fields: [reportedById], references: [id])
  IncidentEvent                                      IncidentEvent[]
  IncidentLink_IncidentLink_fromIncidentIdToIncident IncidentLink[]           @relation("IncidentLink_fromIncidentIdToIncident")
  IncidentLink_IncidentLink_toIncidentIdToIncident   IncidentLink[]           @relation("IncidentLink_toIncidentIdToIncident")
  LearningEntry                                      LearningEntry[]
  MarketplaceListing                                 MarketplaceListing[]
  MissingPerson                                      MissingPerson[]
  OperationalObservation                             OperationalObservation[]
  safeZones                                          SafeZone[]
  shipments                                          Shipment[]
  VolunteerAssignment                                VolunteerAssignment[]
  // Game-changer relations
  SituationBrief                                     SituationBrief[]
  IncidentTask                                       IncidentTask[]
  EmergencyBroadcast                                 EmergencyBroadcast[]
  ResponseBottleneck                                 ResponseBottleneck[]

  // The reporter (FK) — always from session, never from frontend
  @@index([status])
  @@index([type])
}

model IncidentCluster {
  id             String       @id @default(cuid())
  clusterCode    String       @unique
  type           IncidentType
  confidence     Float
  incidentIds    String
  geoSpreadKm    Float
  latestReportAt DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  eventType  String
  data       String
  createdAt  DateTime @default(now())
  Incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentLink {
  id                                             String   @id @default(cuid())
  fromIncidentId                                 String
  toIncidentId                                   String
  relation                                       String
  strength                                       Float    @default(0.5)
  explanation                                    String?
  source                                         String   @default("deterministic")
  createdAt                                      DateTime @default(now())
  Incident_IncidentLink_fromIncidentIdToIncident Incident @relation("IncidentLink_fromIncidentIdToIncident", fields: [fromIncidentId], references: [id], onDelete: Cascade)
  Incident_IncidentLink_toIncidentIdToIncident   Incident @relation("IncidentLink_toIncidentIdToIncident", fields: [toIncidentId], references: [id], onDelete: Cascade)

  @@unique([fromIncidentId, toIncidentId, relation])
  @@index([fromIncidentId])
  @@index([toIncidentId])
}

model LearningEntry {
  id             String    @id @default(cuid())
  incidentId     String?
  category       String
  lesson         String
  recommendation String?
  confidence     Float?
  source         String    @default("deterministic")
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  Incident       Incident? @relation(fields: [incidentId], references: [id])

  @@index([status])
}

model MarketplaceListing {
  id            String       @id @default(cuid())
  listingCode   String       @unique
  kind          String       @default("OFFER")
  agencyName    String
  resourceType  ResourceType
  quantity      Int
  unit          String       @default("units")
  pricePerUnit  Float?
  notes         String?
  status        String       @default("OPEN")
  matchedWithId String?
  incidentId    String?
  listedById    String?
  demo          Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now())
  Incident      Incident?    @relation(fields: [incidentId], references: [id])
  User          User?        @relation(fields: [listedById], references: [id])

  @@index([status])
}

model MissingPerson {
  id               String    @id @default(cuid())
  fullName         String
  age              Int?
  gender           String?
  description      String?
  lastSeenAt       DateTime?
  lastSeenLocation String
  latitude         Float?
  longitude        Float?
  contactName      String?
  contactPhone     String?
  medicalNeeds     Boolean   @default(false)
  childOrElder     Boolean   @default(false)
  priorityScore    Float?
  status           String    @default("OPEN")
  foundAt          DateTime?
  incidentId       String?
  reportedById     String
  source           String    @default("deterministic")
  demo             Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  Incident         Incident? @relation(fields: [incidentId], references: [id])
  User             User      @relation(fields: [reportedById], references: [id])

  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  message   String
  createdAt DateTime         @default(now())
  entityId  String?
  read      Boolean          @default(false)
  type      NotificationType
  User      User?            @relation(fields: [userId], references: [id])

  @@index([read])
  @@index([userId])
}

model NotificationLog {
  id               String    @id @default(cuid())
  userId           String?
  incidentId       String?
  notificationType String
  channel          String
  recipient        String
  title            String
  message          String
  status           String    @default("PENDING")
  sentAt           DateTime?
  readAt           DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  User             User?     @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([notificationType])
  @@index([status])
  @@index([userId])
}

// Secure in-app 1:1 chat (Citizen ↔ Officer ↔ Admin ↔ Responder ↔ Volunteer).
// Conversations are strictly two-participant, stored with normalized participant
// ids (participantA < participantB) so each pair maps to exactly one thread.
model ChatConversation {
  id           String        @id @default(cuid())
  participantA String
  participantB String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]

  @@unique([participantA, participantB])
  @@index([participantA])
  @@index([participantB])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  senderId       String
  // TEXT | LOCATION | INCIDENT_LOCATION | IMAGE
  kind           String           @default("TEXT")
  body           String?
  latitude       Float?
  longitude      Float?
  accuracy       Float?
  photoUrl       String?
  photoMime      String?
  photoName      String?
  incidentId     String?
  incidentTitle  String?
  locationLabel  String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("ChatMessagesSent", fields: [senderId], references: [id])
  translations   MessageTranslation[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([readAt])
}

model OperationalObservation {
  id          String   @id @default(cuid())
  incidentId  String
  createdById String
  kind        String
  recordCode  String
  payload     Json
  simulated   Boolean  @default(false)
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [createdById], references: [id])
  Incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, kind, recordCode, createdAt])
}

model OtpVerification {
  id          String    @id @default(cuid())
  identifier  String
  channel     String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumed    Boolean   @default(false)
  consumedAt  DateTime?
  userId      String?
  createdAt   DateTime  @default(now())
  User        User?     @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@index([identifier, purpose])
}

model ReliefRequest {
  id            String              @id @default(cuid())
  requestedById String
  needType      ReliefNeedType
  quantity      String?
  urgency       Severity            @default(MEDIUM)
  notes         String?
  location      String
  latitude      Float?
  longitude     Float?
  status        ReliefRequestStatus @default(OPEN)
  incidentId    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now())
  User          User                @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([needType])
  @@index([status])
}

// Emergency Services (Feature 9) - Nearby hospitals, fire stations, police, etc.
model EmergencyService {
  id           String    @id @default(cuid())
  name         String
  type         String // HOSPITAL, FIRE_STATION, POLICE, AMBULANCE_SERVICE, RELIEF_CENTER, SHELTER, SAFE_ZONE
  latitude     Float
  longitude    Float
  address      String?
  phone        String?
  availability String    @default("OPEN") // OPEN, BUSY, CLOSED, LIMITED
  services     String? // JSON: ["ICU", "Trauma", "24/7"]
  distanceKm   Float? // Calculated from incident
  incidentId   String?
  source       String    @default("places_api")
  demo         Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  Incident     Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([incidentId])
}

// Safe Places for citizens (Feature 6, 7) - Hospitals, shelters, relief centers, etc.
model SafePlace {
  id            String    @id @default(cuid())
  name          String
  type          String // EMERGENCY_SHELTER, HOSPITAL, EMERGENCY_MEDICAL_CENTER, EMERGENCY_SERVICE, FIRE_RESCUE, RELIEF_CENTER, SAFE_ZONE
  latitude      Float
  longitude     Float
  address       String?
  phone         String?
  availability  String    @default("OPEN") // OPEN, BUSY, FULL, CLOSED
  amenities     String? // JSON: ["food", "water", "medical", " bedding"]
  distanceKm    Float? // Calculated from citizen location
  estimatedTime Int? // Estimated travel time in minutes
  incidentId    String?
  citizenId     String? // For personalized safe place recommendations
  source        String    @default("places_api")
  demo          Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
  Incident      Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  User          User?     @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([incidentId])
  @@index([citizenId])
}

// Resource status tracking timeline (Feature 12)
model ResourceTrackingEvent {
  id           String    @id @default(cuid())
  resourceId   String
  assignmentId String?
  status       String // REQUESTED, APPROVED, ASSIGNED, DISPATCHED, EN_ROUTE, ARRIVED, COMPLETED
  latitude     Float?
  longitude    Float?
  locationName String?
  timestamp    DateTime  @default(now())
  details      String? // JSON: { distanceRemaining, eta, speed, heading }
  recordedById String?
  reason       String?
  Resource     Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  User         User?     @relation(fields: [recordedById], references: [id])
  incident     Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId   String?

  @@index([resourceId])
  @@index([assignmentId])
  @@index([status])
  @@index([timestamp])
}

// Resource destination tracking (Feature 2-5)
model ResourceDestination {
  id                String    @id @default(cuid())
  resourceId        String
  incidentId        String
  destinationType   String    @default("INCIDENT") // INCIDENT, HOSPITAL, SAFE_ZONE, SHELTER, RELIEF_CENTER
  name              String
  latitude          Float
  longitude         Float
  address           String?
  status            String    @default("EN_ROUTE") // EN_ROUTE, ARRIVED, CANCELLED
  distanceRemaining Float? // Remaining distance in km
  etaMinutes        Int? // Estimated time to arrival in minutes
  lastUpdated       DateTime  @default(now())
  arrivedAt         DateTime?
  confirmedById     String? // Officer who confirmed arrival
  confirmedAt       DateTime?
  autoVerified      Boolean   @default(false) // Auto-verified by geofence
  Resource          Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  Incident          Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user              User?     @relation(fields: [userId], references: [id])
  userId            String?

  @@index([resourceId])
  @@index([incidentId])
  @@index([status])
}

model Resource {
  id                     String                  @id @default(cuid())
  resourceCode           String                  @unique
  name                   String
  type                   ResourceType
  latitude               Float
  longitude              Float
  capacity               Int
  status                 ResourceStatus          @default(AVAILABLE)
  eta                    Int?
  lastUpdated            DateTime                @default(now())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now())
  ResourceAssignment     ResourceAssignment[]
  resourceTrackingEvents ResourceTrackingEvent[]
  resourceDestinations   ResourceDestination[]
  locationUpdates        ResponderLocationUpdate[]
  IncidentTask           IncidentTask[]
  ResponseBottleneck     ResponseBottleneck[]

  @@index([status])
  @@index([type])
}

model ResourceAssignment {
  id           String    @id @default(cuid())
  resourceId   String
  incidentId   String
  status       String    @default("ASSIGNED")
  isPrimary    Boolean   @default(true)
  reason       String?
  assignedById String?
  assignedAt   DateTime  @default(now())
  replacedAt   DateTime?
  User         User?     @relation(fields: [assignedById], references: [id])
  Incident     Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  Resource     Resource  @relation(fields: [resourceId], references: [id])

  @@index([incidentId])
  @@index([resourceId])
}

model ResourceExpiry {
  id             String       @id @default(cuid())
  batchCode      String       @unique
  name           String
  type           ResourceType
  quantity       Int
  unit           String       @default("units")
  storageSite    String
  expiresAt      DateTime
  spoilageRisk   Float?
  recommendation String?
  resourceId     String?
  source         String       @default("deterministic")
  demo           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  @@index([expiresAt])
}

model SafeCheckIn {
  id           String   @id @default(cuid())
  userId       String
  isSafe       Boolean  @default(true)
  message      String?
  latitude     Float?
  longitude    Float?
  locationName String?
  sharedWith   Json?
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SafeZone {
  id                 String               @id @default(cuid())
  name               String
  zoneCode           String               @unique
  type               String
  latitude           Float
  longitude          Float
  capacity           Int
  occupancy          Int                  @default(0)
  riskLevel          RiskLevel            @default(LOW)
  status             String               @default("OPEN")
  amenities          String?
  incidentId         String?
  source             String               @default("deterministic")
  demo               Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  EvacuationCorridor EvacuationCorridor[]
  Incident           Incident?            @relation(fields: [incidentId], references: [id])

  @@index([status])
}

model SafetyContact {
  id                 String    @id @default(cuid())
  ownerId            String
  name               String
  phone              String
  relation           String    @default("FAMILY")
  isPrimary          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  email              String?
  emailVerified      Boolean   @default(false)
  lastNotificationAt DateTime?
  notificationStatus String?
  User               User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model ShelterFeedback {
  id           String        @id @default(cuid())
  incidentId   String?
  shelterName  String
  status       ShelterStatus
  occupancyPct Int?
  waitMinutes  Int?
  suppliesNote String?
  reportedById String
  createdAt    DateTime      @default(now())
  User         User          @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([shelterName])
}

model Shipment {
  id           String    @id @default(cuid())
  shipmentCode String    @unique
  description  String
  origin       String
  destination  String
  incidentId   String?
  status       String    @default("PREPARING")
  currentStep  Int       @default(0)
  eta          DateTime?
  steps        Json
  source       String    @default("deterministic")
  demo         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  Incident     Incident? @relation(fields: [incidentId], references: [id])

  @@index([status])
}

